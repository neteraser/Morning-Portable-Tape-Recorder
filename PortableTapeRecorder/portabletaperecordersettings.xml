<?xml version="1.0" ?>
<portabletaperecorder w="900" h="540">

	<settings id="adcsetup" tapeSlowdownSamples="2" tapeSlowdownMode2Samples= "10" adcIntMaxNatural="32500" />
	
	<settings id="exporttags" artist="yworkshopru" />

	<button id="quit" image="but_quit.png" onMouseOver="but_quit_over.png" x="850" y="50"/>
	<button id="hide" image="but_hide.png" onMouseOver="but_hide_over.png" x="815" y="50"/>
	<button id="info" image="but_info.png" onMouseOver="but_info_over.png" x="765" y="50"/>
	<button id="quitinfo" image="but_quitinfo.png" onMouseOver="but_quitinfo_over.png" x="780" y="480"/>

	
	<switch id="normalize" image1="but_normalize.png" onMouseOver1="but_normalize_over.png" x="215" y="465"
			image2="but_limit.png" onMouseOver2="but_limit_over.png"  />

	<switch id="onoff" image1="but_on.png" onMouseOver1="but_on_over.png" x="380" y="12"
		image2="but_off.png" onMouseOver2="but_off_over.png"  />


	<button id="addriaa" image="but_addriaa.png" onMouseOver="but_addriaa_over.png" x="375" y="465"/>
	<button id="undofx" image="but_undofx.png" onMouseOver="but_undofx_over.png" x="375" y="495"/>
	<button id="settings" image="but_settings.png" onMouseOver="but_settings_over.png" x="500" y="25"/>
	<button id="apply" image="but_apply.png" onMouseOver="but_apply_over.png" x="680" y="18"/>

	<button id="reverb" image="but_reverb.png" onMouseOver="but_reverb_over.png" x="760" y="465"/>
	<button id="superfi" image="but_superfi.png" onMouseOver="but_superfi_over.png" x="760" y="495"/>


	<switch id="rec"
		image1="but_rec.png" onMouseOver1="but_rec_over.png"
		image2="but_stop.png" onMouseOver2="but_stop_over.png"
		x="20" y="470"
	/>

	<switch id="play"
		image1="but_play.png" onMouseOver1="but_play_over.png"
		image2="but_stopplay.png" onMouseOver2="but_stopplay_over.png"
		x="90" y="470"
	/>

	<switch id="zoom"
		image1="but_zoomin.png" onMouseOver1="but_zoomin_over.png"
		image2="but_zoomout.png" onMouseOver2="but_zoomout_over.png"
		image3="but_zoom3.png" onMouseOver3="but_zoom3_over.png"
		x="430" y="25"
	/>

	<switch id="remaster"
	image1="but_remaster.png" onMouseOver1="but_remaster_over.png"
	image2="but_remaster_playing.png" onMouseOver2="but_remaster_playing_over.png"
	x="550" y="465"
	/>

	<switch id="loop"
		image1="but_loop_off.png" onMouseOver1="but_loop_off_over.png"
		image2="but_loop_on.png" onMouseOver2="but_loop_on_over.png"
		x="165" y="485"
	/>

	<switch id="export" 
			image1="but_exportwav.png" onMouseOver1="but_exportwav_over.png" 
			image2="but_exportmp3.png" onMouseOver2="but_exportmp3_over.png" 
			x="215" y="495"/>

	<regulator id="RQ" image="regulator.png" onPress="regulator_press.png" imagePtr="regulatorptr.png" x="650" y="465" diameter="60" defaultvalue="0.5" />

	<track id="track" x="50" y="250" w="700" h="100" />

	<meter id="meter" image="meter.png" x="850" y="100" w="36" h="320" offsetx="12" offsety="12"/>

	<equalizer y="435" cropLeft="1" cropRight="0"/>

	<resources id="beep" sound="beepforme.wav" />

	<checker id="basslib" image1="but_lib_bass.png" image2="but_lib_bass_on.png" x="60" y="480"/>

	<checker id="portytracklib" image1="but_lib_portytrack.png" image2="but_lib_portytrack_on.png" x="240" y="480"/>

	<checker id="delayfast" image1="but_delay_fast.png" image2="but_delay_fast_on.png" x="580" y="480"/>

	<checker id="delayslow" image1="but_delay_slow.png" image2="but_delay_slow_on.png" x="710" y="480"/>

</portabletaperecorder>